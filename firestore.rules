rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    //match /{document=**} {
     // allow read, write // if
      //    request.time < timestamp.date(2021, 3, 30);
      //}
      //match logged users in the players collection
      match /players/{userId} {
      	allow create: if request.auth.uid != null;
        allow read; //: if request.auth.uid == userId;
    
      }
      
      //match logged users in the games collection
      match /games/{gameId} {
      	allow create, write: if request.auth.uid != null;
        allow read;
      }
      
      // match documents in the rooms collection
      match /rooms/{roomId} {
      	allow read, write: if request.auth.uid != null;
      }
    }
  }
  